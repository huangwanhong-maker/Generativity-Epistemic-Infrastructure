@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/GRTargets.cmake")
foreach(component IN LISTS GR_FIND_COMPONENTS)
  if(TARGET GR::${component})
    set(GR_${component}_FOUND TRUE)
  else()
    set(GR_${component}_FOUND FALSE)
  endif()
endforeach()
check_required_components(GR)
